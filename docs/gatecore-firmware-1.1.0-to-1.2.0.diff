+void SystemController::abortImport_() {
+  if (!db_.isImportMode()) return;
+  db_.setImportMode(false);
+  db_.load();                       // RAM -> exactly what is on flash again
+  network_.setImportActive(false);
+  restoreIdleOrScanScreen_();
+}
