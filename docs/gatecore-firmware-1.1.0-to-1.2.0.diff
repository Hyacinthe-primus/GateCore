+// Prints a double as a valid, round-trippable JSON number. Arduino's
+// Print::print(double) uses 2 decimals (0.333 -> "0.33", silently corrupting
+// list/JSON exports) and emits "nan"/"inf"/"ovf", which are not JSON.
+static void printJsonDouble(double v) {
+  if (isnan(v) || isinf(v)) { Serial.print('0'); return; }
+  char buf[32];
+  snprintf(buf, sizeof(buf), "%.15g", v);
+  if (strtod(buf, nullptr) != v) snprintf(buf, sizeof(buf), "%.17g", v);
+  Serial.print(buf);
+}
